[Unit]
Description=Chainprobe backend
After=network.target

[Service]
Type=simple
User=chainprobe
Group=chainprobe
WorkingDirectory=/opt/chainprobe
ExecStart=/opt/chainprobe/chainprobe
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=~CAP_SYS_ADMIN
Environment=RUST_LOG=chainprobe=info
Environment=PORT=3001

[Install]
WantedBy=multi-user.target
